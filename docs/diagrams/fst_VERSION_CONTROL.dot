digraph T_VERSION_CONTROL {
    node [shape=circle, fontsize=9, width=0.25, height=0.25, fixedsize=false];
    edge [fontsize=9];
    __start [shape=point, label=""];
    n_F_GIT [shape=doublecircle, label="F_GIT"];
    n_q_G [shape=circle, label="G"];
    n_q_GI [shape=circle, label="I"];
    n_q_GIT [shape=circle, label="T"];
    n_q_Gi [shape=circle, label="i"];
    n_q_Git [shape=circle, label="t"];
    n_q_g [shape=circle, label="g"];
    n_q_gi [shape=circle, label="i"];
    n_q_git [shape=circle, label="t"];
    n_q₀ [shape=circle, label="q₀"];
    __start -> n_q₀;
    n_q₀ -> n_q_G [label="G:lambda"];
    n_q_G -> n_q_Gi [label="i:lambda"];
    n_q_Gi -> n_q_Git [label="t:lambda"];
    n_q_Git -> n_F_GIT [label="lambda:GIT"];
    n_q₀ -> n_q_g [label="g:lambda"];
    n_q_g -> n_q_gi [label="i:lambda"];
    n_q_gi -> n_q_git [label="t:lambda"];
    n_q_git -> n_F_GIT [label="lambda:GIT"];
    n_q_G -> n_q_GI [label="I:lambda"];
    n_q_GI -> n_q_GIT [label="T:lambda"];
    n_q_GIT -> n_F_GIT [label="lambda:GIT"];
}
