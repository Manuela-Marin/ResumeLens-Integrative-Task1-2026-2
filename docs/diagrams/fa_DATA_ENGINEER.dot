digraph DATA_ENGINEER {
    rankdir=LR;
    node [shape=circle, fontsize=10];
    __start [shape=point, label=""];
    n_q₀ [shape=circle, label="q₀"];
    n_q₁ [shape=circle, label="q₁"];
    n_q₂ [shape=circle, label="q₂"];
    n_q₃ [shape=circle, label="q₃"];
    n_q₄ [shape=circle, label="q₄"];
    n_q₅ [shape=doublecircle, label="q₅"];
    __start -> n_q₀;
    n_q₀ -> n_q₁ [label="PYTHON, SCALA"];
    n_q₁ -> n_q₂ [label="SPARK, HADOOP, KAFKA"];
    n_q₂ -> n_q₃ [label="AIRFLOW, DBT"];
    n_q₃ -> n_q₄ [label="BIGQUERY, POSTGRESQL, SQL"];
    n_q₄ -> n_q₅ [label="GIT"];
}
